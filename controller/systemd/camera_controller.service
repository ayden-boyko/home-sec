[Unit]
Description=Camera Controller Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi4b
WorkingDirectory=/home/pi4b
ExecStart=/usr/bin/python3 /home/pi4b/camera_controller.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
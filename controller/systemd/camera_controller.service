[Unit]
Description=Camera Controller Server
After=network-online.target
Wants=network-online.target

[Service]
User=pi4b
Type=simple
WorkingDirectory=/home/pi4b
ExecStart=/home/pi4b/camera_venv/bin/python /home/pi4b/camera_controller.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
[Unit]
Description=Camera RTSP Stream
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
SupplementaryGroups=video gpio
Environment=PYTHONUNBUFFERED=1
RuntimeDirectory=camera_stream
WorkingDirectory=/run/camera_stream
ExecStart=/usr/bin/python3 /usr/local/bin/camera_stream.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target